  "form": {
    "heading": "Send us a Message",
    "formspreeId": "mzervyba",
    "fields": [
      {
        "name": "name",
        "label": "Name",
        "type": "text",
        "placeholder": "Your Name",
        "required": true
      },
      {
        "name": "company",
        "label": "Company",
        "type": "text",
        "placeholder": "Company Name",
        "required": true
      },
      {
        "name": "email",
        "label": "Email",
        "type": "email",
        "placeholder": "email@company.com",
        "required": true
      },
      {
        "name": "phone",
        "label": "Phone",
        "type": "tel",
        "placeholder": "+91 XXXXX XXXXX",
        "required": true,
        "pattern": "(?:\\+91(?:\\s|-)?|0)?\\d(?:(?:\\s|-)?\\d){9}",
        "patternMessage": "Enter a valid 10-digit phone number, optionally starting with +91 or 0"
      },
      {
        "name": "inquiryType",
        "label": "Inquiry Type",
        "type": "select",
        "placeholder": "Select inquiry type",
        "required": true,
        "options": [
          { "value": "", "label": "Select inquiry type" },
          { "value": "rental", "label": "Equipment Rental" },
          { "value": "chemicals", "label": "Cleaning Chemicals" },
          { "value": "spill", "label": "Spill Products" },
          { "value": "equipment", "label": "Maintenance Equipment" },
          { "value": "maintenance", "label": "Maintenance Service" },
          { "value": "support", "label": "Technical Support" },
          { "value": "partnership", "label": "Partnership Opportunity" }
        ]
      },
      {
        "name": "message",
        "label": "Message",
        "type": "textarea",
        "placeholder": "Describe your requirements...",
        "required": false
      }
    ],
    "submitButton": "SEND MESSAGE",
    "successMessage": "Thank you for your inquiry. Our team will contact you shortly."
  }
